# Optional local overrides (not shell-sourced; no command interpolation)
AUTOMATION_PROFILE=default
AUTOMATION_SELECTED_PACKAGES=
AUTOMATION_EXCLUDED_PACKAGES=
AUTOMATION_NONINTERACTIVE=false
AUTOMATION_LERD=true
AUTOMATION_PREFER_FLATPAK=false
AUTOMATION_ENABLE_AUR=false
AUTOMATION_PACKAGE_TIMEOUT=900
AUTOMATION_RETRIES=2
AUTOMATION_BACKUP_DIR=
# Optional absolute private directory; default XDG_STATE_HOME/automation-toolkit
AUTOMATION_STATE_DIR=
AUTOMATION_PROJECT_SITES_DIR=
AUTOMATION_AI_BACKEND=llamacpp
AUTOMATION_AI_CONTEXT=32768
AUTOMATION_AI_THREADS=auto
AUTOMATION_AI_QUOTA=auto
AUTOMATION_AI_PORT=auto
AUTOMATION_PREFER_SHELLY=false
AUTOMATION_AUTO_SEARCH=true
AUTOMATION_SEARCH_LIMIT=5
